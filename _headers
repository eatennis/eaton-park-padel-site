/
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS/JS aren't fingerprinted and change during the build — revalidate each
# load (ETag → 304 when unchanged) so updates appear immediately, not after a day.
/css/*
  Cache-Control: public, no-cache
/js/*
  Cache-Control: public, no-cache
# Images rarely change; cache a day. Rename the file to bust it if you swap one.
/images/*
  Cache-Control: public, max-age=86400
